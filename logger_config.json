{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "custom": {
            "format": "{asctime} - {levelname} - {message}",
            "style": "{",
            "datefmt": "%d/%m %H:%M:%S"
        }
    },
    "handlers": {
        "stdout": {
            "level": "INFO",
            "class": "logging.StreamHandler",
            "formatter": "custom"
        },
        "file": {
            "level": "INFO",
            "class": "logging.handlers.RotatingFileHandler",
            "filename": "logs/info.log",
            "formatter": "custom",
            "mode": "a",
            "maxBytes": 104857600,
            "backupCount": 5,
            "encoding": "utf-8"
        },
        "file_debug": {
            "level": "DEBUG",
            "class": "logging.handlers.RotatingFileHandler",
            "filename": "logs/debug.log",
            "formatter": "custom",
            "mode": "a",
            "maxBytes": 104857600,
            "backupCount": 5,
            "encoding": "utf-8"
        },
        "file_error": {
            "level": "ERROR",
            "class": "logging.handlers.RotatingFileHandler",
            "filename": "logs/error.log",
            "formatter": "custom",
            "mode": "a",
            "maxBytes": 104857600,
            "backupCount": 5,
            "encoding": "utf-8"
        }
    },
    "loggers": {
        "aiohttp.access": {
            "handlers": ["file_debug"],
            "level": "DEBUG",
            "propagate": true
        },
        "custom": {
            "handlers": ["stdout", "file", "file_debug", "file_error"],
            "level": "DEBUG",
            "propagate": true
        },
        "aiogram.dispatcher.dispatcher": {
            "handlers": ["stdout", "file", "file_debug"],
            "level": "INFO",
            "propagate": true
        }
    }
}